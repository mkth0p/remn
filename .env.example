# Copy to .env (project root). Everything is optional.

# --- Server -------------------------------------------------------------
# FORENSIC_DEBUG=0
# FORENSIC_MAX_UPLOAD_MB=2048
# FORENSIC_IN_MEMORY_MB=256
# FORENSIC_TMP_DIR=backend/tmp
# FORENSIC_LOG_LEVEL=INFO

# --- An instance open to strangers (see docs/security.md) ------------------
# FORENSIC_BROWSER_ONLY=1             # parse and return rows only: no server store, uploads, jobs, lookups, server-side models
# FORENSIC_RATE_LIMIT_PER_MIN=60      # per-address budget on the heavy paths, 0 = off
# FORENSIC_TRUST_PROXY=1              # take the client address from X-Forwarded-For (only behind your own proxy)
# FORENSIC_UPLOAD_MAX_AGE_S=1800      # how long an abandoned upload may sit in the staging area
# FORENSIC_UPLOAD_SWEEP_S=300         # how often the staging area is swept; 0 disables the timer
# FORENSIC_TMP_MAX_GB=4               # total the staging area may hold; a further upload is refused

# --- Server case stores (DuckDB, gigabyte-scale) --------------------------
# FORENSIC_CASES_DIR=backend/data/cases
# FORENSIC_STORE_THRESHOLD_MB=150     # UI suggests the server store above this file size
# FORENSIC_MAX_CHUNKED_GB=64          # per-file cap for chunked uploads
# FORENSIC_CHUNK_MB=16

# --- Ollama (local AI mode) ----------------------------------------------
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma4-hauhaucs:latest
# OLLAMA_NUM_CTX=32768
# OLLAMA_TIMEOUT=600

# --- Reputation providers (all opt-in from the UI; keys only enable them) -
# abuse.ch Auth-Key (URLhaus + MalwareBazaar), free at https://auth.abuse.ch
# ABUSECH_AUTH_KEY=
# VIRUSTOTAL_API_KEY=
# ABUSEIPDB_API_KEY=
# GREYNOISE_API_KEY=
# IPINFO_TOKEN=
# SPAMHAUS_DQS_KEY=
# GOOGLE_SAFEBROWSING_KEY=
# REPUTATION_TIMEOUT=15
# REPUTATION_CACHE_TTL=21600
