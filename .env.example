# Copy to .env (project root). Everything is optional.
# Each line is one variable the backend reads, at its default, with its meaning after it.
# A default that differs in browser-only mode says so. Remove the leading "# " to set one.

# --- Server -------------------------------------------------------------
# FORENSIC_DEBUG=0                    # Django debug pages; never on an instance others can reach
# FORENSIC_SECRET_KEY=                # Django secret key; empty draws a random one at each start (no sessions or signed cookies use it)
# FORENSIC_LOG_LEVEL=INFO             # level of the console log (DEBUG, INFO, WARNING, ERROR)
# FORENSIC_THREADS=8                  # worker threads of backend/run.py, which sets it from --threads
# FORENSIC_MAX_UPLOAD_MB=2048         # largest single-request upload
# FORENSIC_IN_MEMORY_MB=256           # files below this size are parsed in memory
# FORENSIC_MAX_MESSAGE_MB=256         # largest single message (eml, msg, one message of an mbox) parsed; 48 in browser-only mode
# FORENSIC_INGEST_MAX_S=0             # seconds one ingest request may parse before it returns what it has, 0 = no limit; 1800 in browser-only mode
# FORENSIC_TMP_DIR=backend/tmp        # staging area for uploads being parsed (default: backend/tmp of the checkout)
# FORENSIC_DATA_DIR=backend/data      # offline block lists, YARA rules and GeoLite2 (default: backend/data of the checkout)

# --- Access from another machine (see docs/setup.md, "Remote access") ------
# FORENSIC_AUTH_TOKEN=                # shared token every /api request must send in X-Forensic-Client; empty = none, for loopback use
# FORENSIC_ALLOWED_HOSTS=             # host names the server answers besides 127.0.0.1 and localhost, comma-separated
# FORENSIC_AUTH_FAILURES_PER_MIN=10   # wrong access tokens a minute from one client address before it gets 429; 0 = no limit
# FORENSIC_ALLOW_NO_TOKEN=0           # 1: let backend/run.py start beyond loopback without FORENSIC_AUTH_TOKEN, because something in front decides who gets in
# FORENSIC_PUBLISHED_ON=              # for a container: the host address its port is published on; a loopback address there needs no token
# REMN_NO_TOKEN=                      # docker compose: 1 passes FORENSIC_ALLOW_NO_TOKEN=1 to the container, to publish on the network without REMN_TOKEN

# --- An instance open to strangers (see docs/security.md) ------------------
# FORENSIC_BROWSER_ONLY=0             # 1: parse and return rows only, no server store, jobs, lookups or server-side models
# FORENSIC_PROFILE=                   # what the deployment guarantees, for the notice before a first upload: "public" (docker-compose.public.yml) or empty
# FORENSIC_RATE_LIMIT_PER_MIN=0       # requests a minute per client address on the heavy paths, 0 = off
# FORENSIC_TRUST_PROXY=0              # 1: take the client address from X-Forwarded-For (only behind your own proxy)
# FORENSIC_MAX_HEAVY_REQUESTS=0       # heavy requests (parses, correlation, conversion) in flight at once, 0 = no cap; threads minus 2 in browser-only mode
# FORENSIC_MAX_HEAVY_PER_CLIENT=0     # the same per client address, 0 = no cap; 2 in browser-only mode
# FORENSIC_MAX_JSON_INFLIGHT_MB=0     # JSON bodies being parsed at once, in MiB, 0 = no cap; 64 in browser-only mode
# FORENSIC_UPLOAD_MAX_AGE_S=21600     # how long an abandoned upload may sit in the staging area; 1800 in browser-only mode
# FORENSIC_UPLOAD_SWEEP_S=300         # how often the staging area is swept; 0 disables the timer
# FORENSIC_TMP_MAX_GB=4               # total the staging area may hold; a further upload is refused

# --- Server case stores (DuckDB, gigabyte-scale) --------------------------
# FORENSIC_CASES_DIR=backend/data/cases  # one folder per server-store case (default: cases/ under FORENSIC_DATA_DIR)
# FORENSIC_STORE_THRESHOLD_MB=150     # UI suggests the server store above this file size
# FORENSIC_MAX_CHUNKED_GB=64          # per-file cap for chunked uploads
# FORENSIC_CHUNK_MB=16                # size of one chunk of a chunked upload

# --- Ollama (local AI mode) ----------------------------------------------
# OLLAMA_HOST=http://127.0.0.1:11434  # the Ollama the server proxy transport relays to
# OLLAMA_MODEL=gemma4-hauhaucs:latest # model offered by default, and used when the analyst picks none
# OLLAMA_NUM_CTX=32768                # context window asked of the model, in tokens
# OLLAMA_TIMEOUT=600                  # seconds one model call may take

# --- Claude Code connector (see docs/ai.md) -------------------------------
# CLAUDE_CODE_ENABLED=1               # runs the claude command line of the account running the server; what it is sent leaves the machine for Anthropic; 0 = off
# CLAUDE_CODE_BIN=                    # path of the claude command line; empty = found on PATH
# CLAUDE_CODE_TIMEOUT=600             # seconds one connector call may take

# --- Hayabusa, an optional detection engine for event logs (see docs/detection.md) ---
# HAYABUSA_ENABLED=1                  # 0 keeps Hayabusa out of ingest even when it is installed
# HAYABUSA_PATH=                      # path of the hayabusa binary; empty = found on PATH (the Docker image sets it)
# HAYABUSA_RULES=                     # its rules folder; empty = the rules folder beside the binary
# HAYABUSA_MIN_LEVEL=low              # lowest Hayabusa level kept (informational, low, medium, high, critical)
# HAYABUSA_MAX_S=300                  # seconds one run may take before it is stopped and what it wrote is kept
# HAYABUSA_MAX_MB=1536                # memory one run may reach before it is stopped
# HAYABUSA_CONCURRENCY=1              # runs at once
# HAYABUSA_WAIT_S=20                  # seconds an ingest waits for a free run before it goes on without the engine
# HAYABUSA_ARGS=                      # replaces Hayabusa's option set for a release whose flags moved; empty = REMN's own

# --- Reputation providers (all opt-in from the UI; keys only enable them) -
# ABUSECH_AUTH_KEY=                   # abuse.ch Auth-Key (URLhaus and MalwareBazaar), free at https://auth.abuse.ch
# VIRUSTOTAL_API_KEY=                 # VirusTotal
# ABUSEIPDB_API_KEY=                  # AbuseIPDB
# GREYNOISE_API_KEY=                  # GreyNoise
# IPINFO_TOKEN=                       # ipinfo.io
# SPAMHAUS_DQS_KEY=                   # Spamhaus Data Query Service
# GOOGLE_SAFEBROWSING_KEY=            # Google Safe Browsing
# REPUTATION_TIMEOUT=15               # seconds one provider call may take
# REPUTATION_CACHE_TTL=21600          # seconds a provider's answer is kept and reused

# --- Build ---------------------------------------------------------------
# REMN_BUILD_ID=                      # source commit shown in the app; empty = read from the checkout's .git or the archive's BUILD_ID
# REMN_SOURCE_URL=https://github.com/mkth0p/remn  # where the app links the source of the commit it runs
